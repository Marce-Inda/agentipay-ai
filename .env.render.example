# Configuración para despliegue en Render
# Copia este archivo a .env.render y completa con tu API Key

# Tu API Key de Render (genera una en https://dashboard.render.com/account/api-keys)
RENDER_API_KEY=rnd_your_api_key_here

# Opcional: ID del servicio existente (dejar vacío para crear uno nuevo)
# RENDER_SERVICE_ID=

# Opcional: Region (oregon, frankfurt, singapore, ohio, virginia)
# RENDER_REGION=oregon

# Opcional: Plan (starter, standard, pro, pro_max, pro_plus, pro_ultra)
# RENDER_PLAN=starter
