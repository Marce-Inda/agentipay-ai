# ==========================================
# PAYPAL DEVELOPER SANDBOX CREDENTIALS
# Get yours for free at https://developer.paypal.com
# Server-side only: never expose PayPal credentials to the browser.
# ==========================================
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox # 'sandbox' or 'live' (production)
# Payment rail contract for milestone settlement:
#  - PAYPAL_CLIENT_ID + PAYPAL_CLIENT_SECRET -> real PayPal Sandbox payouts.
#  - No credentials + PAYPAL_SIMULATION_MODE=true -> deterministic local
#    simulation rail (never produces real transfers).
#  - No credentials + PAYPAL_SIMULATION_MODE=false -> payouts are suppressed:
#    the settlement is recorded in the durable ledger only, without claiming
#    funds moved through PayPal (rejected outright in production).
# Fail-closed by default.
PAYPAL_SIMULATION_MODE=false

# ==========================================
# AI AGENT & LLM PROVIDER API KEYS
# Supports OpenAI, OpenRouter, Claude, or Gemini
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_MODEL_NAME=gpt-4o-mini # e.g. gpt-4o-mini, gpt-4o, claude-3-5-sonnet

# ==========================================
# AUTHENTICATION & DURABLE LEDGER
# DATABASE_URL is required in production. Without it the app refuses
# to serve authenticated traffic.
# ==========================================
DATABASE_URL=postgresql://agenticpay:password@localhost:5432/agenticpay
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# Set to false to disable new account creation entirely.
REGISTRATION_ENABLED=true
# Required in production. Share only with authorized operators.
REGISTRATION_INVITE_CODE=change_me_to_a_long_random_value

# ==========================================
# APP CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical public origin used for CSRF origin validation.
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
